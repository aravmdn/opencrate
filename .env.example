# Copy this file to .env.local and fill in what you need.
# Only JAMENDO_CLIENT_ID is required; everything else switches on optional features.

# Required: search, previews, matching, and downloads.
# Get a free client ID at https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Optional: Spotify playlist import. Create a Web API app at https://developer.spotify.com/dashboard
# and add http://127.0.0.1:3000/api/spotify/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: smarter matching and "describe a vibe" search with Jev.
# Get an API key at https://console.typesafe.ai
TYPESAFE_API_KEY=
